# Postgres (Neon). En blanco = usa SQLite local (DATABASE_URI) como fallback.
POSTGRES_URL=

# SQLite local para desarrollo sin credenciales de producción.
DATABASE_URI=file:./dev.db

# Secret de Payload (JWT, hashing). Generar uno propio para producción.
PAYLOAD_SECRET=

# Token de Vercel Blob (subida de imágenes/archivos). Sin esto, en Vercel las
# imágenes subidas se pierden en el próximo deploy.
BLOB_READ_WRITE_TOKEN=

# URL pública del sitio (usada por Live Preview, metadata, etc).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
